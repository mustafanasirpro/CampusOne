# Local development:
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Vercel production:
# VITE_API_BASE_URL=https://campusone-backend-otc4.onrender.com/api/v1

# --- AI Live Tutor ---
# Provider: "groq" (free hosted, fast) or "ollama" (local, offline)
VITE_TUTOR_PROVIDER=groq
# Groq: qwen/qwen3.8-27b   |   Ollama: qwen3:4b
VITE_TUTOR_MODEL=qwen/qwen3.8-27b
#
# BRING YOUR OWN KEY (BYOK): each user adds their OWN free keys in the app
# (AI Assistant → "Add your own free API keys"), stored in their browser and sent
# as the `x-tutor-key` header. The proxy prefers that header, so visitors use their
# own key — not yours.
#
# The *_API_KEY values below are an OPTIONAL fallback used ONLY when a request has
# no user key (handy for your own local dev). For a PUBLIC deployment, LEAVE THESE
# EMPTY so nobody can use your key without adding their own.
GROQ_API_KEY=

# --- Tutor images (search + generation) ---
VITE_IMAGE_GEN=on
VITE_IMAGE_GEN_PROVIDER=pollinations   # pollinations (free) | gemini (needs billing)
GEMINI_API_KEY=

# --- Vision (drawing / pointing on the board) ---
VITE_VISION_PROVIDER=openrouter        # openrouter | gemini | off
VITE_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# Optional fallback only (see BYOK note above); users add their own at openrouter.ai/keys.
OPENROUTER_API_KEY=
