# Local development:
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Vercel production:
# VITE_API_BASE_URL=https://campusone-backend-otc4.onrender.com/api/v1

# --- AI Live Tutor ---
#
# BRING YOUR OWN KEY (BYOK): each user adds their OWN free keys in the app
# (AI Assistant → "Add your own free API keys"). Keys live in that user's browser
# (localStorage) and the browser calls Groq / OpenRouter / Gemini DIRECTLY with
# them (those APIs allow CORS). There is NO server key and NO proxy — so it works
# on the deployed site, and no visitor can ride on anyone else's key.
#
# => You do NOT need to set any *_API_KEY here. Nothing below is required; the app
#    defaults to the Groq BYOK flow out of the box. These vars only let you change
#    defaults at build time:
#
# Default provider is "groq" (hosted BYOK). Set "ollama" for fully-local offline.
# VITE_TUTOR_PROVIDER=groq
# Default Groq model (used if unset): qwen/qwen3.8-27b
# VITE_TUTOR_MODEL=qwen/qwen3.8-27b

# --- Tutor images (search + generation) ---
VITE_IMAGE_GEN=on
VITE_IMAGE_GEN_PROVIDER=pollinations   # pollinations (free, no key) | gemini (user adds their key)

# --- Vision (drawing / pointing on the board) ---
VITE_VISION_PROVIDER=openrouter        # openrouter | gemini | off
VITE_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
